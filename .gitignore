# that would otherwise churn the diff on every refresh.
public/og/
public/icon-*.png
public/apple-touch-icon.png
public/favicon.ico
public/favicon.svg

# Copied from data/graphs by prebuild. Tracking it duplicated 19MB, because the
# symlink that used to live here was materialized into real files by git.
public/graphs/
