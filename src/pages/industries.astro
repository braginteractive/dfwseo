---
import Head from '../components/Head.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { headline, labelFor } from '../lib/markets.js'
import { valueRows } from '../lib/market-value.js'
import '../styles/global.css'

const rows = valueRows()
const max = rows[0].value
const usd = (n) => '$' + Math.round(n).toLocaleString()

/*
 * Leads with the number because that is the page's only claim to a click.
 * "What DFW industries spend on search" describes the page; "$X a month"
 * is the fact the page is worth opening for, and it is the one thing no
 * competing result has.
 */
const monthly = usd(rows.reduce((a, r) => a + r.value, 0))
const TITLE = `DFW search is worth ${monthly} a month · DFW SEO`
const DESCRIPTION = `Monthly ad-equivalent search value across ${rows.length} Dallas and Fort Worth industries, ranked, with the keyword driving each one. This is how we chose which markets to map.`

/*
 * Dataset plus ItemList. The table is genuinely ordered and the order is the
 * content, so ItemList states it rather than leaving a crawler to guess
 * whether the rows mean anything. Only the top ten are enumerated: the point
 * is the ranking's shape, not a machine-readable copy of the whole table.
 */
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'DFW search market value by industry',
    description: DESCRIPTION,
    url: new URL('/industries/', Astro.site).href,
    creator: { '@type': 'Organization', name: 'DFW SEO', url: new URL('/', Astro.site).href },
    spatialCoverage: { '@type': 'Place', name: 'Dallas-Fort Worth metroplex, Texas' },
    variableMeasured: 'Monthly search volume multiplied by cost per click',
    measurementTechnique: 'Keyword volume and CPC from third-party search data, summed per industry',
    isAccessibleForFree: true,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'DFW industries by monthly search value',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: rows.length,
    itemListElement: rows.slice(0, 10).map((r) => ({
      '@type': 'ListItem', position: r.pos, name: r.name,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'DFW link graph', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Market value' },
    ],
  },
]
---
<html lang="en">
<head>
  <Head title={TITLE} description={DESCRIPTION} card="industries" schema={schema} />
</head>
<body>
  <Nav />

  <header class="head wrap">
    <p class="eyebrow">Market value · Dallas and Fort Worth</p>
    <h1>What DFW industries spend on search</h1>
    <p class="lede">Search volume multiplied by cost per click, across {rows.length} industries.
    Advertisers bid what a lead is worth to them, so this is the best available proxy for which
    markets actually have money in them. It is also how we chose which markets to map.</p>
  </header>

  <section class="wrap sec">
    <table class="val">
      <thead>
        <tr><th class="p">#</th><th>Industry</th><th class="num">Monthly value</th>
          <th class="num">Volume</th><th class="num">CPC</th><th>Mapped</th></tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr class={r.tier ? 'is-tier' : ''}>
            <td class="p mono">{r.pos}</td>
            <td class="name">{r.key ? labelFor(r.key) : headline(r.name)}</td>
            <td class="num mono v">
              <span class="bar" style={`--w:${(r.value / max).toFixed(4)}`}></span>{usd(r.value)}
            </td>
            <td class="num mono dim">{r.vol.toLocaleString()}</td>
            <td class="num mono dim">${r.cpc.toFixed(2)}</td>
            <td>{r.mapped
              ? <a class="go" href={`/dallas/${r.key}`}>{r.tier ? 'mapped' : 'data only'}</a>
              : <span class="no">·</span>}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="wrap sec notes">
    <h2>Three things this table does not say</h2>
    <div class="cards">
      <div class="card">
        <h3>High value is not the same as winnable</h3>
        <p>Insurance tops the list at {usd(rows[0].value)}, but that spend belongs to State Farm,
        Geico and Progressive. On <span class="mono">"car insurance quote"</span> only 2 of the
        top 12 results are local businesses. On <span class="mono">"insurance agency"</span> it
        is 6 of 12.</p>
        <p class="k">We map the agency side only.</p>
      </div>
      <div class="card">
        <h3>Volume is not money</h3>
        <p>Real estate draws 26,580 searches a month at $0.58 a click. Fitness draws 23,500 at
        $2.22. Both are large and neither is a market where search leads are worth much.</p>
        <p class="k">Value, not traffic, drove the selection.</p>
      </div>
      <div class="card">
        <h3>Some industries are understated</h3>
        <p>DFW roofing is hail-driven storm restoration, sold door to door and through insurance
        adjusters. This table measures search demand, not industry size, so roofing places 30th
        while being a far larger business than that suggests.</p>
        <p class="k">We map it anyway.</p>
      </div>
    </div>
    <p class="foot-note">Restricted health categories (addiction treatment, chiropractic,
    fertility) return no volume data from Google's advertising tools rather than genuinely zero
    demand, and are excluded from the table rather than shown as zero.
    <a href="/methodology">How this was built</a>.</p>
  </section>
  <Footer />
</body>
</html>

<style>
  .head { padding: 54px var(--gutter) 30px; }
  .head .lede { max-width: 62ch; }
  .sec { padding: 34px var(--gutter) 46px; border-top: 1px solid var(--line); }

  .val { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .val th { text-align: left; color: var(--dim); font-family: var(--mono); font-weight: 400;
    font-size: 10px; letter-spacing: .08em; text-transform: uppercase; padding: 0 12px 10px;
    border-bottom: 1px solid var(--line); }
  .val th.num, .val td.num { text-align: right; }
  .val td { padding: 9px 12px; border-bottom: 1px solid var(--line-soft); white-space: nowrap; }
  .val tr:hover td { background: var(--panel); }
  .val .p { color: #4a5260; font-size: 11px; width: 1%; }
  /* Names come from the value scan's own vocabulary ('hvac', 'legal /
     personal injury'), so they are cased in the template: CSS capitalize gave
     'Hvac' and 'Legal / Personal Injury'. */
  .val .name { color: var(--ink-soft); }
  .val .dim { color: var(--dim); }
  .val .v { position: relative; color: var(--ink); }
  .val .bar { position: absolute; left: 12px; right: 12px; bottom: 2px; height: 2px; border-radius: 2px;
    background: linear-gradient(to right, var(--ember) calc(var(--w) * 100%), transparent 0); opacity: .55; }
  .val tr.is-tier .name { color: var(--ink); font-weight: 500; }
  .val tr.is-tier .p { color: var(--ember); }
  .go { font-family: var(--mono); font-size: 10.5px; text-decoration: none; color: var(--green);
    background: #1d2a22; border-radius: 4px; padding: 2px 7px; }
  .go:hover { color: var(--ink); }
  .no { color: #3a4049; }

  .notes h2 { margin-bottom: 20px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 14px; }
  .card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 18px; }
  .card h3 { font-family: var(--sans); font-size: 14.5px; font-weight: 600; margin: 0 0 10px; color: var(--ink); }
  .card p { font-size: 13.5px; color: var(--ink-soft); margin: 0 0 10px; text-wrap: pretty; line-height: 1.55; }
  .card .mono { font-family: var(--mono); font-size: .9em; color: var(--ink); }
  .card .k { color: var(--ember); margin: 0; font-size: 13px; }
  .foot-note { color: var(--dim); font-size: 12.5px; margin: 26px 0 0; max-width: 80ch; text-wrap: pretty; }

  @media (max-width: 760px) { .val { font-size: 12px; } .val td, .val th { padding: 8px 7px; } }
</style>
